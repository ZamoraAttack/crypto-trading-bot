# ─── Dashboard login ────────────────────────────────────────────────────────
# PIN required to log into the dashboard. Pick your own value — there is no
# default, and the login route fails closed (500) if this isn't set.
DASHBOARD_PIN=

# ─── ZAMO assistant (voice + text chat, department reasoning) ──────────────
# Separate billing from a Claude Pro/Max subscription — create a key at
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# ─── Google connectors (Gmail + Calendar) ───────────────────────────────────
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
# Same client ID/secret is shared across both connectors.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/oauth/callback
CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/oauth/callback
