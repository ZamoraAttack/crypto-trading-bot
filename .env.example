# ─── Trading Mode ──────────────────────────────────────────────────────────────
# "paper" = simulate trades only. "live" = execute real Coinbase orders.
TRADING_MODE=paper

# ─── Capital & Risk ────────────────────────────────────────────────────────────
INITIAL_BALANCE=50.0
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=5.0
MAX_OPEN_POSITIONS=3
SIGNAL_SCORE_THRESHOLD=65.0
SCAN_INTERVAL_SECONDS=45

# ─── LunarCrush ────────────────────────────────────────────────────────────────
# Free tier key from https://lunarcrush.com/developers/api/authentication
# Bot runs with social scoring disabled until this is set.
LUNARCRUSH_API_KEY=

# ─── Coinbase Advanced Trade ───────────────────────────────────────────────────
# CDP key format — use the JSON file Coinbase downloaded when you created the key.
# Required only for LIVE trading mode. Paper mode uses public endpoints only.
#
# Option A (recommended): point to the downloaded JSON key file
COINBASE_KEY_FILE=/home/youruser/crypto-bot/coinbase_key.json
#
# Option B: paste values directly (private key must be on one line with \n)
COINBASE_API_KEY=
COINBASE_API_SECRET=

# ─── Dashboard Auth ────────────────────────────────────────────────────────────
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme_use_a_strong_password
DASHBOARD_JWT_SECRET=generate_a_random_64_char_string_here

# ─── Internal API Security ─────────────────────────────────────────────────────
# Used for Next.js → FastAPI server-to-server calls
INTERNAL_API_KEY=generate_another_random_64_char_string_here

# ─── Service Ports ─────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=3000

# ─── Paths (VPS) ───────────────────────────────────────────────────────────────
DATABASE_PATH=/home/youruser/crypto-bot/data/trading.db
LOG_PATH=/home/youruser/crypto-bot/logs/bot.log
POLYMARKET_DATA_DIR=/home/youruser/.bullpen/copytrade
