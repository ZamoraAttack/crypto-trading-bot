[Unit]
Description=Crypto Bot FastAPI Server
After=network.target

[Service]
Type=simple
User=zamoraattack
WorkingDirectory=/home/zamoraattack/crypto-bot/backend
EnvironmentFile=/home/zamoraattack/crypto-bot/.env
ExecStart=/home/zamoraattack/crypto-bot/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
