[Unit]
Description=Crypto Trading Bot Loop
After=network.target crypto-api.service
Requires=crypto-api.service

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/crypto-bot/backend
EnvironmentFile=/home/deploy/crypto-bot/.env
ExecStart=/home/deploy/crypto-bot/venv/bin/python3 bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
